generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  INDIVIDUAL
  PLANNER
}

model Organizer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  accountType        AccountType @default(INDIVIDUAL)
  eventsCreatedCount Int         @default(0)
  isAdmin            Boolean     @default(false)

  events       Event[]
  redeemedCode AccessCode?
}

model AccessCode {
  id          String      @id @default(cuid())
  code        String      @unique
  accountType AccountType
  label       String?
  createdAt   DateTime    @default(now())

  usedAt            DateTime?
  usedByOrganizerId String?    @unique
  usedByOrganizer   Organizer? @relation(fields: [usedByOrganizerId], references: [id])
}

model Event {
  id          String   @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  title       String
  slug        String   @unique
  description String?
  eventDate   DateTime
  location    String?
  notes       String?
  createdAt   DateTime @default(now())

  messageTemplate String?
  showTableOnRsvp Boolean @default(true)
  askDietaryOnRsvp Boolean @default(true)
  askMessageOnRsvp Boolean @default(true)
  askCompanionNamesOnRsvp Boolean @default(false)

  invitationLinkUrl String?

  logoImage     Bytes?
  logoImageType String?

  showQrOnConfirmation Boolean @default(true)

  publicRsvpToken      String? @unique
  generalMaxCompanions Int?    @default(5) // null = sin límite de acompañantes

  reminderDaysAfter Int? @default(3) // null = recordatorios desactivados

  guests      Guest[]
  tasks       Task[]
  budgetItems BudgetItem[]
  tables      Table[]

  @@index([organizerId])
}

enum TableShape {
  ROUND
  RECT
}

model Table {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  shape     TableShape @default(ROUND)
  seats     Int        @default(8)
  x         Float      @default(80)
  y         Float      @default(80)
  createdAt DateTime   @default(now())

  guests Guest[]

  @@index([eventId])
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Guest {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  token String @unique

  maxCompanions       Int         @default(0)
  status              GuestStatus @default(PENDING)
  companionsConfirmed Int?
  messageFromGuest    String?
  dietaryNotes        String?
  respondedAt         DateTime?
  invitationSentAt    DateTime?
  reminderSentAt      DateTime?

  tableName String?
  tableId   String?
  table     Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  invitationLinkUrl String?

  checkinToken    String    @unique
  checkedInAt     DateTime?
  checkedInPasses Int?

  createdAt DateTime @default(now())

  companions Companion[]

  @@index([eventId])
}

model Companion {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  name      String
  attending Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([guestId])
}

model Task {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([eventId])
}

model BudgetItem {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        String
  estimatedAmount Float
  actualAmount    Float?
  createdAt       DateTime @default(now())

  @@index([eventId])
}
