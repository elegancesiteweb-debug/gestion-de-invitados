generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  INDIVIDUAL
  PLANNER
}

model Organizer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  accountType        AccountType @default(INDIVIDUAL)
  eventsCreatedCount Int         @default(0)
  isAdmin            Boolean     @default(false)

  // Credenciales propias del organizador para sus integraciones (cifradas, salvo resendFromEmail).
  // Si están vacías, la app usa las variables de entorno globales como respaldo.
  resendApiKey           String?
  resendFromEmail        String?
  stripeSecretKey        String?
  mercadoPagoAccessToken String?
  clipApiKey             String?
  notifyByEmail          Boolean @default(true)

  // Marca propia del negocio (se muestra en páginas de cara al invitado/cliente).
  brandName     String?
  brandColor    String?
  brandLogo     Bytes?
  brandLogoType String?

  // Link público de "solicitar cotización" (cuestionario de onboarding).
  leadIntakeToken String? @unique

  events        Event[]
  redeemedCode  AccessCode?
  vendors       Vendor[]
  leads         Lead[]
  teamMembers   TeamMember[]
  leadQuestions LeadQuestion[]
}

enum TeamRole {
  ADMIN
  COLLABORATOR
}

model TeamMember {
  id           String    @id @default(cuid())
  organizerId  String
  organizer    Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  passwordHash String
  role         TeamRole  @default(COLLABORATOR)
  createdAt    DateTime  @default(now())

  @@index([organizerId])
}

enum LeadQuestionType {
  TEXT
  TEXTAREA
  NUMBER
}

model LeadQuestion {
  id          String           @id @default(cuid())
  organizerId String
  organizer   Organizer        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  label       String
  fieldType   LeadQuestionType @default(TEXT)
  required    Boolean          @default(false)
  order       Int              @default(0)
  createdAt   DateTime         @default(now())

  @@index([organizerId])
}

model Vendor {
  id          String    @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  name        String
  category    String?
  phone       String?
  email       String?
  notes       String?
  createdAt   DateTime  @default(now())

  eventVendors EventVendor[]

  @@index([organizerId])
}

model EventVendor {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vendorId       String
  vendor         Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  clientApproved Boolean?
  createdAt      DateTime @default(now())

  @@unique([eventId, vendorId])
  @@index([eventId])
  @@index([vendorId])
}

model ClientComment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([eventId])
}

model AccessCode {
  id          String      @id @default(cuid())
  code        String      @unique
  accountType AccountType
  label       String?
  createdAt   DateTime    @default(now())

  usedAt            DateTime?
  usedByOrganizerId String?    @unique
  usedByOrganizer   Organizer? @relation(fields: [usedByOrganizerId], references: [id])
}

model Event {
  id          String   @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  title       String
  slug        String   @unique
  description String?
  eventDate   DateTime
  location    String?
  notes       String?
  createdAt   DateTime @default(now())

  messageTemplate String?
  showTableOnRsvp Boolean @default(true)
  askDietaryOnRsvp Boolean @default(true)
  askMessageOnRsvp Boolean @default(true)
  askCompanionNamesOnRsvp Boolean @default(false)

  invitationLinkUrl String?

  logoImage     Bytes?
  logoImageType String?

  showQrOnConfirmation Boolean @default(true)

  publicRsvpToken   String? @unique
  clientPortalToken String? @unique

  generalMaxCompanions Int?    @default(5) // null = sin límite de acompañantes

  reminderDaysAfter Int? @default(3) // null = recordatorios desactivados

  colorPalette String? // hex separados por coma, ej. "#c9a84c,#2a2118"
  styleNotes   String?

  guests           Guest[]
  tasks            Task[]
  budgetItems      BudgetItem[]
  tables           Table[]
  timelineItems    TimelineItem[]
  styleGuideImages StyleGuideImage[]
  eventVendors     EventVendor[]
  clientComments   ClientComment[]

  @@index([organizerId])
}

model TimelineItem {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  time        String
  title       String
  responsible String?
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model StyleGuideImage {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  image     Bytes
  imageType String
  createdAt DateTime @default(now())

  @@index([eventId])
}

enum TableShape {
  ROUND
  RECT
}

model Table {
  id        String     @id @default(cuid())
  eventId   String
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  shape     TableShape @default(ROUND)
  seats     Int        @default(8)
  x         Float      @default(80)
  y         Float      @default(80)
  createdAt DateTime   @default(now())

  guests Guest[]

  @@index([eventId])
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Guest {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  token String @unique

  maxCompanions       Int         @default(0)
  status              GuestStatus @default(PENDING)
  companionsConfirmed Int?
  messageFromGuest    String?
  dietaryNotes        String?
  respondedAt         DateTime?
  invitationSentAt    DateTime?
  reminderSentAt      DateTime?

  tableName String?
  tableId   String?
  table     Table?  @relation(fields: [tableId], references: [id], onDelete: SetNull)

  invitationLinkUrl String?

  checkinToken    String    @unique
  checkedInAt     DateTime?
  checkedInPasses Int?

  createdAt DateTime @default(now())

  companions Companion[]

  @@index([eventId])
}

model Companion {
  id        String   @id @default(cuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  name      String
  attending Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([guestId])
}

model Task {
  id        String    @id @default(cuid())
  eventId   String
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean   @default(false)
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  @@index([eventId])
}

model BudgetItem {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category        String
  estimatedAmount Float
  actualAmount    Float?
  createdAt       DateTime @default(now())

  @@index([eventId])
}

enum LeadStage {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model Lead {
  id               String    @id @default(cuid())
  organizerId      String
  organizer        Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  name             String
  email            String?
  phone            String?
  notes            String?
  stage            LeadStage @default(NEW)
  convertedEventId String?
  intakeAnswers    Json?
  createdAt        DateTime  @default(now())

  proposals Proposal[]
  contracts Contract[]
  invoices  Invoice[]

  @@index([organizerId])
}

model Proposal {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title     String
  notes     String?
  createdAt DateTime @default(now())

  items ProposalItem[]

  @@index([leadId])
}

model ProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  description String
  amount      Float
  createdAt   DateTime @default(now())

  @@index([proposalId])
}

model Contract {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title      String
  content    String
  token      String    @unique
  signedAt   DateTime?
  signerName String?
  signerIp   String?
  createdAt  DateTime  @default(now())

  @@index([leadId])
}

enum PaymentProvider {
  STRIPE
  MERCADOPAGO
  CLIP
}

model Invoice {
  id                String          @id @default(cuid())
  leadId            String
  lead              Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  description       String
  amount            Float
  currency          String          @default("mxn")
  provider          PaymentProvider @default(STRIPE)
  status            String          @default("pending") // pending | paid
  token             String          @unique
  providerSessionId String?
  dueDate           DateTime?
  label             String?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())

  @@index([leadId])
}
