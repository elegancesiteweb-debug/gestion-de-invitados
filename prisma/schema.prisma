generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  INDIVIDUAL
  PLANNER
}

model Organizer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  accountType        AccountType @default(INDIVIDUAL)
  eventsCreatedCount Int         @default(0)
  isAdmin            Boolean     @default(false)

  events       Event[]
  redeemedCode AccessCode?
}

model AccessCode {
  id          String      @id @default(cuid())
  code        String      @unique
  accountType AccountType
  label       String?
  createdAt   DateTime    @default(now())

  usedAt            DateTime?
  usedByOrganizerId String?    @unique
  usedByOrganizer   Organizer? @relation(fields: [usedByOrganizerId], references: [id])
}

model Event {
  id          String   @id @default(cuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  title       String
  slug        String   @unique
  description String?
  eventDate   DateTime
  location    String?
  notes       String?
  createdAt   DateTime @default(now())

  messageTemplate String?
  showTableOnRsvp Boolean @default(true)

  publicRsvpToken      String? @unique
  generalMaxCompanions Int?    @default(5) // null = sin límite de acompañantes

  guests Guest[]

  @@index([organizerId])
}

enum GuestStatus {
  PENDING
  CONFIRMED
  DECLINED
}

model Guest {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  name  String
  email String?
  phone String?

  token String @unique

  maxCompanions       Int         @default(0)
  status              GuestStatus @default(PENDING)
  companionsConfirmed Int?
  messageFromGuest    String?
  respondedAt         DateTime?
  invitationSentAt    DateTime?

  tableName String?

  checkinToken    String    @unique
  checkedInAt     DateTime?
  checkedInPasses Int?

  createdAt DateTime @default(now())

  @@index([eventId])
}
